    {
      "type": "cards",
      "variant": "grid",
      "title": "What ships in v1",
      "columns": 3,
      "cards": [
        {
          "label": "Deterministic routing",
          "sub": "no LLM on the hot path",
          "lines": [
            "intent table",
            "78% of turns"
          ],
          "style": "primary"
        },
        {
          "label": "Flow fixtures",
          "sub": "replayable",
          "lines": [
            "record once",
            "diff on change"
          ]
        },
        {
          "label": "Typed views",
          "sub": "render anywhere",
          "lines": [
            "TUI",
            "web",
            "comment thread"
          ]
        },
        {
          "label": "Story YAML",
          "sub": "the state machine",
          "lines": [
            "rooms + intents",
            "effects + host calls"
          ]
        },
        {
          "label": "Tracing",
          "sub": "every turn",
          "lines": [
            "layer-by-layer",
            "ms + tokens"
          ]
        },
        {
          "label": "PDF / MP4",
          "sub": "one spec",
          "lines": [
            "narrated cut",
            "per-step pages"
          ],
          "style": "secondary"
        }
      ],
      "caption": "One spec, three outputs."
    },
    {
      "type": "cards",
      "variant": "agenda",
      "title": "Where we are going",
      "cards": [
        {
          "label": "The problem",
          "sub": "two extremes dominate, neither is enough"
        },
        {
          "label": "The shape",
          "sub": "a workflow that runs where the work lives"
        },
        {
          "label": "The mechanism",
          "sub": "deterministic flow with an LLM fallback"
        },
        {
          "label": "The proof",
          "sub": "recorded turns, replayed and traced"
        }
      ]
    },
    {
      "type": "cards",
      "variant": "numbered",
      "title": "How a turn resolves",
      "cards": [
        {
          "label": "Match the intent",
          "sub": "against the room's deterministic table"
        },
        {
          "label": "Fall back to the LLM",
          "sub": "only when no rule fires"
        },
        {
          "label": "Apply effects",
          "sub": "set world vars, call hosts, transition"
        },
        {
          "label": "Render the view",
          "sub": "the same typed view, every surface"
        }
      ]
    },
    {
      "type": "cards",
      "variant": "list",
      "title": "Non-goals",
      "cards": [
        {
          "label": "Not a chatbot",
          "sub": "the flow is the product, not the chat"
        },
        {
          "label": "Not a prompt chain",
          "sub": "rooms and transitions, not a DAG of prompts"
        },
        {
          "label": "Not a no-code toy",
          "sub": "YAML you can read, diff, and review"
        }
      ]
    },
    {
      "type": "cards",
      "variant": "icon-row",
      "title": "Runs where work lives",
      "columns": 4,
