        }
      ]
    },
    {
      "type": "cards",
      "variant": "before-after",
      "title": "The shift",
      "left": {
        "label": "Before",
        "lines": [
          "Prompt chains you cannot replay",
          "Behaviour drifts every release",
          "No record of why a turn went one way",
          "Logic buried in a mega-prompt"
        ]
      },
      "right": {
        "label": "After",
        "lines": [
          "A state machine you can diff",
          "Deterministic routing, LLM as fallback",
          "Every turn recorded and replayable",
          "Logic in reviewable YAML"
        ]
      },
      "caption": "Same surface area. Auditable behaviour."
    },
    {
      "type": "cards",
      "variant": "versus",
      "title": "Two extremes",
      "left": {
        "label": "Rigid forms",
        "lines": [
          "Predictable",
          "Cannot handle the unsaid",
          "Users bounce off the rails"
        ]
      },
      "right": {
        "label": "Open chat",
        "lines": [
          "Flexible",
          "Unbounded, unauditable",
          "Drifts turn to turn"
        ]
      },
      "caption": "Kitsoki sits between: a flow that bends without breaking."
    },
    {
      "type": "cards",
      "variant": "point-counterpoint",
      "title": "Does determinism kill flexibility?",
      "left": {
        "label": "The worry",
        "lines": [
          "If routing is a table, the bot feels scripted",
          "Edge cases will fall through the rules"
        ]
      },
      "right": {
        "label": "The answer",
        "lines": [
          "The table covers the 78% that repeat",
          "The LLM catches the rest as a fallback",
          "Both paths are recorded and traceable"
        ]
      }
    },
    {
      "type": "cards",
      "variant": "pros-cons",
      "title": "Recording every turn",
      "left": {
        "label": "Pros",
        "lines": [
          "Replay any session deterministically",
          "Diff behaviour across releases",
          "Trace why a turn routed as it did"
        ]
      },
      "right": {
        "label": "Cons",
        "lines": [
          "Fixtures need refreshing when flows change",
          "Storage grows with session volume"
        ]
      },
      "caption": "The audit trail is worth the upkeep."
    },
    {
      "type": "cards",
      "variant": "qa",
      "title": "Frequently asked",
      "question": "Does it call an LLM on every turn?",
      "answer": [
        "No. Routing is a deterministic intent table.",
        "The LLM is a fallback for the turns no rule matches —",
        "roughly one in five, all recorded and replayable."
      ],
      "caption": "Cheap, fast, and auditable by default."
    },
    {
      "type": "title",
      "title": "Code layouts"
    },
    {
      "type": "code",
      "variant": "source",
      "title": "router.js",
      "lang": "javascript",
      "code": "export function route(turn) {\n  for (const layer of LAYERS) {\n    const hit = layer.match(turn);\n    if (hit) return hit.intent;\n  }\n  return callLLM(turn);\n}",
      "highlight": [
        4
      ],
      "annotations": [
        {
          "line": 4,
          "text": "the deterministic layers return early — the LLM is the fallback, not the default"
        }
      ],
      "caption": "Most turns never reach callLLM().",
      "hold": 200
    },
    {
      "type": "code",
      "variant": "diff",
      "title": "store.js",
      "lang": "diff",
      "code": " export const store = reactive({\n   scene: null,\n-  revealed: [],\n+  revealed: new Set(),\n   isRevealed(id) {\n-    return this.revealed.includes(id);\n+    return this.revealed.has(id);\n   },\n });",
      "caption": "Switch the reveal set to a real Set for O(1) lookups.",
      "hold": 190
    },
    {
      "type": "code",
      "variant": "function-io",
      "title": "route()",
      "call": "route('kick off the next bug')",
      "code": "// synonym MISS · slot MISS · LLM HIT (240ms)",
      "returns": "{ intent: 'pickup_bug', source: 'llm' }",
      "caption": "One turn, three layers, a single deterministic result.",
      "hold": 180
    },
