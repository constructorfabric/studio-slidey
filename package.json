{
  "name": "slidey",
  "version": "1.0.0",
  "description": "Deterministic, spec-driven declarative video generator — renders a JSON scene spec into a narrated MP4 (Puppeteer + edge-tts + ffmpeg)",
  "main": "src/index.js",
  "bin": {
    "slidey": "src/index.js",
    "slidey-mcp": "src/mcp.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./rrweb-buffer": "./web/rrweb/buffer.js",
    "./rrweb-player": "./web/rrweb/RrwebPlayer.vue",
    "./rrweb-chapters": "./web/rrweb/chapters.js",
    "./rrweb-format": "./src/rrweb-format.js",
    "./tour": "./src/tour/index.js",
    "./tour-adapter": "./src/tour/tour-adapter.js",
    "./graph-projection": "./web/graph-projection/renderer.js",
    "./drawio": "./src/drawio.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node src/index.js doctor",
    "estimate": "node src/index.js examples/hello.slidey.json --estimate",
    "hello": "node src/index.js examples/hello.slidey.json hello.mp4",
    "build:render": "SLIDEY_TARGET=render vite build && node web/inline-render.mjs",
    "build:web": "SLIDEY_TARGET=web vite build",
    "build:single": "node web/build-single.mjs",
    "build": "npm run build:render && npm run build:web",
    "dev": "SLIDEY_TARGET=web vite",
    "edit-mode-smoke": "node tools/slidey-edit-mode-smoke.js",
    "test:vscode": "npm run build:web && node --test tools/vscode-slidey/e2e/*.e2e.js",
    "prepublishOnly": "npm run build:web"
  },
  "files": [
    "src",
    "web",
    "data",
    "dist",
    "dist-render",
    "tools/vscode-slidey",
    "docs",
    ".claude/skills",
    "examples",
    "index.html",
    "render.html",
    "vite.config.js"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "cytoscape": "^3.34.0",
    "dagre": "^0.8.5",
    "jsonpath-plus": "^10.4.0",
    "mermaid": "^11.7.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.11.0",
    "rrweb": "^2.0.1"
  },
  "overrides": {
    "ts-dedent": "2.2.0",
    "stylis": "4.3.6"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vscode/test-electron": "^3.0.0",
    "playwright": "^1.61.1",
    "vite": "^5.4.21",
    "vue": "^3.5.30"
  }
}
